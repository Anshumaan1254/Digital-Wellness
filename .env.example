# MongoDB connection string. Local Docker:  mongodb://127.0.0.1:27017
# Production (Vercel): a MongoDB Atlas URI, e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# If this is left empty the site still works and stores feedback in a temporary JSON file.
MONGODB_URI=
MONGODB_DB=digital_wellness

# Long random string. Enables the /admin moderation page and the feedback CSV export.
ADMIN_KEY=
